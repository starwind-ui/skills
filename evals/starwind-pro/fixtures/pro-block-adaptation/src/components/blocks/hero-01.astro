---
const dashboardHref = "#";
const docsHref = "#";
---

<section
  class="grid gap-10 rounded-3xl bg-white p-8 shadow-sm md:grid-cols-2 md:p-14 dark:bg-neutral-950 motion-safe:animate-in motion-safe:fade-in motion-reduce:transition-none"
>
  <div class="flex flex-col justify-center gap-6">
    <p class="text-sm font-medium text-primary">Acme</p>
    <h1 class="text-4xl font-semibold tracking-tight">Understand your business</h1>
    <p class="text-muted-foreground">
      A responsive analytics workspace for growing teams.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href={dashboardHref} class="rounded-lg bg-primary px-4 py-2 text-primary-foreground">
        Open dashboard
      </a>
      <a href={docsHref} class="rounded-lg border border-border px-4 py-2">
        Read docs
      </a>
    </div>
  </div>
  <div class="min-h-72 rounded-2xl bg-muted" aria-label="Product preview"></div>
</section>
