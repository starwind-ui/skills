{
  "skill": "skills/starwind-ui",
  "cases": [
    {
      "id": "astro-settings-form",
      "title": "Compose an accessible Astro settings form",
      "fixture": "astro-settings-form",
      "prompt": "Build the account settings page in src/pages/settings.astro. It needs required full-name and email fields with native validation messages, three independently named email/SMS/push values in the same account settings form, and a Save button that enters the documented disabled, busy Spinner state after a valid submit. Use the installed local Starwind components and keep it server-rendered Astro; a small browser script for the submit-state demonstration is fine.",
      "assertions": [
        {
          "type": "contains",
          "file": "src/pages/settings.astro",
          "pattern": "Field(Label|Control|Error|Group)",
          "description": "Uses Starwind Field anatomy",
          "weight": 2,
          "hard": true
        },
        {
          "type": "contains",
          "file": "src/pages/settings.astro",
          "pattern": "<Field\\s[^>]*name=",
          "description": "Keeps native form names on the Field root",
          "weight": 1,
          "hard": true
        },
        {
          "type": "contains",
          "file": "src/pages/settings.astro",
          "pattern": "(gap-|\\bgap\\s*:)",
          "description": "Uses gap for layout spacing",
          "weight": 1
        },
        {
          "type": "not_contains",
          "file": "src/pages/settings.astro",
          "pattern": "space-[xy]-",
          "description": "Avoids space-x/space-y spacing",
          "weight": 1
        },
        {
          "type": "contains",
          "file": "src/pages/settings.astro",
          "pattern": "required",
          "description": "Uses native required validation",
          "weight": 1
        },
        {
          "type": "contains",
          "file": "src/pages/settings.astro",
          "pattern": "<FieldError[^>]+(match=|messageSource=[\\\"']validation[\\\"'])",
          "description": "Associates native validation messages",
          "weight": 2,
          "hard": true
        },
        {
          "type": "contains",
          "file": "src/pages/settings.astro",
          "pattern": "<Switch\\b",
          "description": "Uses Switch for independent preferences",
          "weight": 2,
          "hard": true
        },
        {
          "type": "contains",
          "file": "src/pages/settings.astro",
          "pattern": "aria-busy",
          "description": "Uses accessible loading state",
          "weight": 1
        },
        {
          "type": "contains",
          "file": "src/pages/settings.astro",
          "pattern": "<Spinner",
          "description": "Composes Spinner instead of inventing a loading prop",
          "weight": 1
        },
        {
          "type": "not_contains",
          "file": "src/pages/settings.astro",
          "pattern": "(isLoading|isPending)=",
          "description": "Does not assume unsupported Button loading props",
          "weight": 1,
          "hard": true
        },
        {
          "type": "not_contains",
          "file": "src/pages/settings.astro",
          "pattern": "className=|htmlFor=",
          "description": "Uses Astro rather than React attribute syntax",
          "weight": 1,
          "hard": true
        },
        {
          "type": "contains",
          "file": "src/pages/settings.astro",
          "pattern": "addEventListener\\([^)]*submit",
          "description": "Transitions to loading in response to form submission",
          "weight": 1
        },
        {
          "type": "contains",
          "file": "src/pages/settings.astro",
          "pattern": "disabled",
          "description": "Disables Save while showing its busy state",
          "weight": 1
        },
        {
          "type": "not_contains",
          "file": "src/pages/settings.astro",
          "pattern": "Switch(Control|Label)",
          "description": "Uses the current single-component Astro Switch export",
          "weight": 2,
          "hard": true
        },
        {
          "type": "control_names",
          "file": "src/pages/settings.astro",
          "component": "Switch",
          "names": [
            "email",
            "sms",
            "push"
          ],
          "description": "Submits distinct email, SMS, and push values",
          "weight": 3,
          "hard": true
        },
        {
          "type": "no_nested_tag",
          "file": "src/pages/settings.astro",
          "tag": "form",
          "description": "Keeps one valid account form without nested forms",
          "weight": 3,
          "hard": true
        }
      ],
      "scenario_type": "implementation",
      "integration": {
        "install": true,
        "commands": [
          [
            "pnpm",
            "run",
            "integration"
          ]
        ],
        "browser": true
      }
    },
    {
      "id": "react-profile-combobox",
      "title": "Build a React profile Dialog with standalone Combobox",
      "fixture": "react-profile-combobox",
      "prompt": "Implement src/ProfileEditor.tsx as an edit-profile dialog. Include the user's avatar, required name, bio, a searchable timezone choice, and Cancel/Save actions. Use the existing React Starwind exports, keep the component accessible, and do not add packages.",
      "assertions": [
        {
          "type": "contains",
          "file": "src/ProfileEditor.tsx",
          "pattern": "DialogTitle",
          "description": "Includes an accessible Dialog title",
          "weight": 2,
          "hard": true
        },
        {
          "type": "contains",
          "file": "src/ProfileEditor.tsx",
          "pattern": "AvatarFallback",
          "description": "Pairs Avatar image with a fallback",
          "weight": 1,
          "hard": true
        },
        {
          "type": "contains",
          "file": "src/ProfileEditor.tsx",
          "pattern": "Combobox(Input|Content|Item)",
          "description": "Uses standalone V3 Combobox for searchable choice",
          "weight": 2,
          "hard": true
        },
        {
          "type": "not_contains",
          "file": "src/ProfileEditor.tsx",
          "pattern": "SelectSearch",
          "description": "Does not use removed SelectSearch",
          "weight": 2,
          "hard": true
        },
        {
          "type": "contains",
          "file": "src/ProfileEditor.tsx",
          "pattern": "className=",
          "description": "Uses React className syntax",
          "weight": 1
        },
        {
          "type": "not_contains",
          "file": "src/ProfileEditor.tsx",
          "pattern": "\\sclass=",
          "description": "Does not use Astro class syntax in TSX",
          "weight": 1,
          "hard": true
        },
        {
          "type": "contains",
          "file": "src/ProfileEditor.tsx",
          "pattern": "name=",
          "description": "Preserves native form participation",
          "weight": 1
        },
        {
          "type": "contains",
          "file": "src/ProfileEditor.tsx",
          "pattern": "required",
          "description": "Marks required profile input",
          "weight": 1
        },
        {
          "type": "contains",
          "file": "src/ProfileEditor.tsx",
          "pattern": "(DialogClose|setOpen\\(false\\))",
          "description": "Makes the Cancel action actually close the dialog",
          "weight": 2,
          "hard": true
        }
      ],
      "scenario_type": "implementation",
      "integration": {
        "install": true,
        "commands": [
          [
            "pnpm",
            "run",
            "build"
          ]
        ]
      }
    },
    {
      "id": "theme-customization",
      "title": "Customize semantic tokens without deleting the theme",
      "fixture": "theme-customization",
      "prompt": "Rebrand this Astro project in the active Starwind CSS file: use violet for primary actions, set the global radius seed to 0.75rem, and add a reusable brand/brand-foreground semantic color in both light and dark modes. Ensure the theme initializes before paint in the shared layout. Preserve unrelated tokens, animations, and component variables.",
      "assertions": [
        {
          "type": "contains",
          "file": "src/styles/starwind.css",
          "pattern": "--primary:\\s*var\\(--color-violet-",
          "description": "Changes primary to violet semantically",
          "weight": 1,
          "hard": true
        },
        {
          "type": "contains",
          "file": "src/styles/starwind.css",
          "pattern": "--radius:\\s*0\\.75rem",
          "description": "Changes the global radius seed",
          "weight": 1
        },
        {
          "type": "contains",
          "file": "src/styles/starwind.css",
          "pattern": "--color-brand:\\s*var\\(--brand\\)",
          "description": "Registers brand with Tailwind theme mapping",
          "weight": 2,
          "hard": true
        },
        {
          "type": "contains",
          "file": "src/styles/starwind.css",
          "pattern": "--color-brand-foreground:\\s*var\\(--brand-foreground\\)",
          "description": "Registers brand foreground mapping",
          "weight": 1
        },
        {
          "type": "contains",
          "file": "src/styles/starwind.css",
          "pattern": ":root[\\s\\S]*--brand:[\\s\\S]*--brand-foreground:",
          "description": "Defines light brand pair",
          "weight": 1
        },
        {
          "type": "contains",
          "file": "src/styles/starwind.css",
          "pattern": "\\.dark[\\s\\S]*--brand:[\\s\\S]*--brand-foreground:",
          "description": "Defines dark brand pair",
          "weight": 1
        },
        {
          "type": "css_variables_preserved",
          "file": "src/styles/starwind.css",
          "description": "Preserves every unrelated CSS custom property",
          "weight": 3,
          "hard": true,
          "mutable": [
            "--primary",
            "--primary-accent",
            "--radius"
          ]
        },
        {
          "type": "contains",
          "file": "src/layouts/Layout.astro",
          "pattern": "@starwind-ui/astro/theme",
          "description": "Imports the V3 Astro theme adapter",
          "weight": 1,
          "hard": true
        },
        {
          "type": "contains",
          "file": "src/layouts/Layout.astro",
          "pattern": "<ThemeInitScript\\s*/>",
          "description": "Renders ThemeInitScript in the document",
          "weight": 1,
          "hard": true
        },
        {
          "type": "not_contains",
          "file": "src/layouts/Layout.astro",
          "pattern": "localStorage|getItem\\(\\\"theme",
          "description": "Does not add a competing inline theme controller",
          "weight": 1
        },
        {
          "type": "preserves",
          "file": "src/styles/starwind.css",
          "patterns": [
            "@keyframes accordion-down"
          ],
          "description": "Preserves existing animation definitions",
          "weight": 1,
          "hard": true
        }
      ],
      "scenario_type": "customization",
      "integration": {
        "install": true,
        "commands": [
          [
            "pnpm",
            "run",
            "build"
          ]
        ]
      }
    },
